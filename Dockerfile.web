FROM golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc AS caddy-build
WORKDIR /src
ADD --checksum=sha256:2c3d02078286a6282cdb4d1d8744077788d556659dac0b64d8ed5886a7e5aeb9 https://github.com/caddyserver/caddy/archive/refs/tags/v2.11.4.tar.gz /tmp/caddy.tar.gz
RUN tar -xzf /tmp/caddy.tar.gz --strip-components=1 -C /src \
  && mkdir -p /out \
  && go mod edit -require=golang.org/x/net@v0.56.0 \
  && go mod edit -require=golang.org/x/text@v0.39.0 \
  && go mod edit -require=google.golang.org/grpc@v1.82.1 \
  && go mod tidy \
  && go mod verify \
  && CGO_ENABLED=0 GO111MODULE=on go build -trimpath -mod=readonly -ldflags='-s -w' -tags='nobadger nomysql nopgx' -o /out/caddy ./cmd/caddy \
  && go version -m /out/caddy > /out/caddy.buildinfo

FROM node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS build
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @gutter/web build

FROM caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
RUN addgroup -S -g 10001 gutter \
  && adduser -S -D -H -u 10001 -G gutter gutter \
  && mkdir -p /config /data \
  && chown gutter:gutter /config /data
COPY --chown=root:gutter Caddyfile /etc/caddy/Caddyfile
RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
COPY --from=caddy-build --chown=root:root /out/caddy /usr/bin/caddy
COPY --from=caddy-build --chown=root:root /out/caddy.buildinfo /usr/share/caddy.buildinfo
RUN chmod 0755 /usr/bin/caddy \
  && setcap cap_net_bind_service=+ep /usr/bin/caddy \
  && caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
COPY --from=build --chown=root:root /src/apps/web/build /srv
USER gutter
