FROM node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS build
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @gutter/web build

FROM caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
RUN addgroup -S -g 10001 gutter \
  && adduser -S -D -H -u 10001 -G gutter gutter \
  && mkdir -p /config /data \
  && chown gutter:gutter /config /data
COPY --chown=root:gutter Caddyfile /etc/caddy/Caddyfile
RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
COPY --from=build --chown=root:root /src/apps/web/build /srv
USER gutter
