{
  "name": "gutter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "unit": "tsx --test tests/unit.mjs tests/backup-toc.mjs tests/metrics-status-parser.mjs tests/release-gate.mjs tests/release-gate-adversarial.mjs tests/runtime-acl-policy.mjs tests/page-validation.mts tests/reader-stream.mts tests/reader-http.mts tests/derived-cache.test.mts tests/metadata-provider.mts tests/pwa-icons.mjs tests/user-state-api.mts && corepack pnpm --filter @gutter/web test:ui",
    "test:public": "tsx --test tests/openapi-compat.mts tests/public-api-contract.mts tests/public-page-proxy.mts tests/public-api-runtime.mts tests/integration/public-api-migrations.mts tests/user-state-api.mts",
    "integration:library-roots": "pnpm --filter @gutter/db exec tsx ../../tests/integration/library-roots.mts",
    "integration:page-validation": "pnpm --filter @gutter/db exec tsx ../../tests/integration/page-validation.mts",
    "integration:reconciliation": "pnpm --filter @gutter/db exec tsx ../../tests/integration/reconciliation.mts",
    "integration:catalog": "pnpm --filter @gutter/db exec tsx ../../tests/integration/catalog.mts",
    "integration:access-control": "pnpm --filter @gutter/db exec tsx ../../tests/integration/access-control.mts",
    "integration:catalog-user-state": "pnpm --filter @gutter/db exec tsx ../../tests/integration/catalog-user-state.mts",
    "integration:scale-oracles": "pnpm --filter @gutter/db exec tsx ../../tests/integration/scale-oracles.mts",
    "benchmark:tiny-cbz": "tsx tests/scale-tiny-cbz.mjs",
    "test:scale-capabilities": "node tests/scale-capability.mjs",
    "integration:auth": "tsx tests/auth-integration.mts",
    "integration:auth-runtime": "tsx tests/auth-runtime.mts",
    "integration": "pnpm integration:library-roots && pnpm integration:page-validation && pnpm integration:reconciliation && pnpm integration:catalog && pnpm integration:access-control && pnpm integration:catalog-user-state",
    "build": "turbo run build",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "verify:release-gate": "node scripts/verify-release-gate.mjs",
    "run:release-gates": "sh scripts/run-release-gates.sh",
    "check:openapi-compat": "node scripts/check-openapi-compat.mjs docs/openapi-v1.baseline.json docs/openapi-v1.yaml docs/openapi-v1.json",
    "dev": "docker compose up --build",
    "migrate": "pnpm --filter @gutter/db migrate",
    "verify:operations": "node scripts/verify-operations.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "pg": "8.22.0",
    "prettier": "3.8.1",
    "sharp": "0.35.3",
    "tsx": "4.23.11",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
