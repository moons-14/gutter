{
  "name": "gutter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "unit": "tsx --test tests/unit.mjs tests/page-validation.mts tests/reader-stream.mts tests/pwa-icons.mjs && pnpm --filter @gutter/web test:ui",
    "integration:library-roots": "pnpm --filter @gutter/db exec tsx ../../tests/integration/library-roots.mts",
    "integration:page-validation": "pnpm --filter @gutter/db exec tsx ../../tests/integration/page-validation.mts",
    "integration:reconciliation": "pnpm --filter @gutter/db exec tsx ../../tests/integration/reconciliation.mts",
    "integration:catalog": "pnpm --filter @gutter/db exec tsx ../../tests/integration/catalog.mts",
    "integration": "pnpm integration:library-roots && pnpm integration:page-validation && pnpm integration:reconciliation && pnpm integration:catalog",
    "build": "turbo run build",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "dev": "docker compose up --build",
    "migrate": "pnpm --filter @gutter/db migrate"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.8.1",
    "sharp": "0.35.3",
    "tsx": "4.23.11",
    "turbo": "2.10.7",
    "typescript": "5.9.3"
  }
}
