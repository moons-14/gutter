{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gutter release evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "exactTree",
    "images",
    "gates",
    "platforms",
    "references",
    "threatClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "gutter.release-evidence.v1" },
    "exactTree": {
      "type": "object",
      "required": ["commit", "lockfileSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lockfileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reference", "digest"],
        "properties": {
          "reference": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "command", "commandHash", "artifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "blocked", "unavailable"] },
          "command": { "type": "string", "minLength": 1 },
          "commandHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
        },
        "additionalProperties": false
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "command"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "unavailable"] },
          "command": { "type": "string", "minLength": 1 },
          "reason": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "object",
      "required": ["issue26", "issue27"],
      "properties": {
        "issue26": { "type": "string", "minLength": 1 },
        "issue27": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "threatClaims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "role", "gate", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
        "role": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
