{
  "schemaVersion": "gutter.release-gate.v1",
  "requiredArtifacts": [
    { "path": "docs/license-audit.json", "role": "license-report", "gate": "licenses" },
    { "path": "docs/license-inventory.md", "role": "license-notices", "gate": "licenses" },
    { "path": "docs/openapi-v1.baseline.json", "role": "openapi-baseline", "gate": "openapi" },
    {
      "path": "docs/platform-evidence.schema.json",
      "role": "evidence-schema",
      "gate": "release-contract"
    },
    {
      "path": "scripts/backup-table-manifest.v1",
      "role": "backup-manifest",
      "gate": "backup-restore"
    },
    {
      "path": "scripts/compose-restore-drill.sh",
      "role": "restore-drill",
      "gate": "backup-restore"
    },
    {
      "path": "scripts/migration-compatibility-oracle.sh",
      "role": "migration-oracle",
      "gate": "migrations"
    },
    { "path": "scripts/run-release-gates.sh", "role": "runner", "gate": "release-contract" },
    { "path": "scripts/nas-source-oracle.sh", "role": "nas-oracle", "gate": "nas-source" },
    { "path": "docs/release-notes.md", "role": "release-notes", "gate": "release-contract" },
    { "path": "docs/release-tool-refs.json", "role": "tool-provenance", "gate": "containers" },
    {
      "path": ".github/workflows/release.yml",
      "role": "release-workflow",
      "gate": "release-contract"
    }
  ],
  "requiredGateIds": [
    "dependencies",
    "licenses",
    "secrets",
    "release-contract",
    "format",
    "lint",
    "typecheck",
    "unit",
    "build",
    "compose-config",
    "operations",
    "nas-source",
    "containers",
    "sbom",
    "provenance",
    "migrations",
    "openapi",
    "browser-e2e",
    "compose-smoke",
    "backup-restore",
    "scale-concurrency"
  ],
  "requiredPlatformNames": ["linux", "macos-docker", "windows-docker"],
  "requiredImageNames": ["node", "postgres", "caddy"],
  "requiredApplicationImageNames": ["api", "worker", "web"],
  "threatClaims": {
    "archive-path-containment": "unit",
    "acl-pat": "operations",
    "proxy-boundary": "operations",
    "cache-redaction": "operations",
    "source-immutability": "backup-restore",
    "no-saas": "release-contract"
  },
  "gateCommands": {
    "dependencies": "corepack pnpm install --frozen-lockfile",
    "licenses": "corepack pnpm audit:licenses",
    "secrets": "gitleaks detect --source . --redact",
    "release-contract": "node scripts/verify-release-gate.mjs contract",
    "format": "corepack pnpm check",
    "openapi": "corepack pnpm check:openapi-compat",
    "unit": "corepack pnpm unit",
    "lint": "corepack pnpm lint",
    "typecheck": "corepack pnpm typecheck",
    "build": "corepack pnpm build",
    "browser-e2e": "corepack pnpm --filter @gutter/web test:e2e",
    "migrations": "./scripts/migration-compatibility-oracle.sh",
    "compose-config": "docker compose config",
    "compose-smoke": "docker compose up --abort-on-container-exit --exit-code-from test test",
    "operations": "node scripts/verify-operations.mjs",
    "backup-restore": "./scripts/compose-restore-drill.sh",
    "nas-source": "./scripts/nas-source-oracle.sh",
    "containers": "trivy image pinned release refs",
    "sbom": "syft pinned release refs cyclonedx",
    "provenance": "cosign pinned release refs slsaprovenance",
    "scale-concurrency": "SCALE_FULL=1 production Compose scale oracle"
  },
  "deferredUntil": { "scale-concurrency": "#26 merge" }
}
