{
  "name": "@gutter/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "scan": "node --import tsx src/scan.ts",
    "cache": "node --import tsx src/cache.ts"
  },
  "dependencies": {
    "@gutter/config": "workspace:*",
    "@gutter/derived-cache": "workspace:*",
    "@gutter/db": "workspace:*",
    "@gutter/discovery-scanner": "workspace:*",
    "@gutter/library-roots": "workspace:*",
    "@gutter/page-validator": "workspace:*",
    "@gutter/reader-stream": "workspace:*",
    "chokidar": "5.0.0",
    "pg-boss": "12.27.0",
    "pino": "10.3.1",
    "tsx": "4.23.11"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
